# Copy with npm run setup:init. Never commit real values.
# Supabase Dashboard -> your project's reference and URL
SUPABASE_PROJECT_REF=
SUPABASE_URL=
# Personal access token from the account owning YOUR project (deploy/management only)
SUPABASE_ACCESS_TOKEN=
# Dashboard Connect -> Direct or Session pooler. Copy the actual host/username.
# Remove password from URL; supply it separately below. Add ?sslmode=require.
# Initial setup may use your NEW project's postgres owner; keep this local only.
RADAR_MIGRATION_DATABASE_URL=
RADAR_MIGRATION_DATABASE_PASSWORD=
RADAR_EVALUATOR_ROLE=radar_evaluator
RADAR_READER_ROLE=radar_reader
# Optional Apify API token for LinkedIn. Free-plan checks precede each Actor run.
APIFY_TOKEN=
# Generated by npm run setup:init; never paste the actual values into chat.
RADAR_COLLECTOR_TOKEN=
RADAR_EVALUATOR_TOKEN=
RADAR_READER_TOKEN=
# Optional direct DB clients only; HTTP agent does not need these.
RADAR_EVALUATOR_DATABASE_URL=
RADAR_EVALUATOR_DATABASE_PASSWORD=
RADAR_READER_DATABASE_URL=
RADAR_READER_DATABASE_PASSWORD=
